    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bounty-ai/agent-sdk": "workspace:^",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@bounty-ai/agent-testkit": "workspace:^",
    "@flue/runtime": "2.0.3",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.0.3"
  }
