{
  "name": "@bounty-ai/flue",
  "version": "0.1.0-beta.0",
  "description": "Deprecated: use @bounty-ai/agent-sdk. Official Bounty channel for Flue agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybounty-ai/bounty-agent-sdk.git",
    "directory": "packages/flue"
  },
  "bugs": {
    "url": "https://github.com/trybounty-ai/bounty-agent-sdk/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
