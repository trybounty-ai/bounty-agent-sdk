{
  "name": "@bounty-ai/agent-sdk",
  "version": "0.2.0-beta.1",
  "description": "Server-side TypeScript SDK for connecting agents to Bounty",
  "keywords": ["bounty", "agent", "sdk", "typescript", "webhooks"],
  "author": "Bounty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybounty-ai/bounty-agent-sdk.git",
    "directory": "packages/agent-sdk"
  },
  "bugs": {
    "url": "https://github.com/trybounty-ai/bounty-agent-sdk/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022",
    "clean": "rimraf dist",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
