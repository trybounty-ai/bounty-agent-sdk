{
  "name": "@bounty-ai/mcp",
  "version": "0.0.0",
  "description": "Connect MCP clients to Bounty with a device code instead of a browser redirect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trybounty-ai/bounty-agent-sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/trybounty-ai/bounty-agent-sdk/issues"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "bounty-mcp": "./dist/index.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
