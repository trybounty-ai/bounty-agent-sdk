{
  "name": "bounty-agent-integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "oxlint packages examples scripts --deny-warnings",
    "lint:fix": "oxlint packages examples scripts --fix",
    "test": "turbo run test && pnpm test:package",
    "test:live:workspace": "pnpm build && node scripts/test-live-workspace.mjs",
    "test:package": "pnpm build && node scripts/test-packed-sdk.mjs",
    "typecheck": "turbo run typecheck",
    "openapi:check": "node scripts/check-openapi.mjs",
    "openapi:update": "node scripts/update-openapi.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm openapi:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@oxlint/plugins": "1.79.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.79.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
